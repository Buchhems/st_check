# ===== Pflicht =====
BIB_NR=700018
BIB_PASSWORT=dein-passwort

# ===== Optional: Bibliothek (default Stadtbibliothek Darmstadt) =====
BIB_LIBRARY_ID=9

# ===== Optional: Sofatutor-Aktivierung =====
# Falls gesetzt, wird der Lizenzcode nach dem Abruf automatisch mit diesen
# Daten an sofatutor.com übertragen ("Zugang freischalten").
# Sind sie nicht gesetzt, wird nur der Code ausgegeben bzw. per E-Mail geschickt.
# SOFATUTOR_EMAIL=deine-sofatutor@email.de
# SOFATUTOR_PASSWORT=dein-sofatutor-passwort

# ===== Optional: Intervall / Modus =====
# Prüfintervall, erlaubte Einheiten: Zahlenwerte = Minuten, "90m", "2h", "7d".
# Default 60 (Minuten). CHECK_INTERVAL_MIN wird als Fallback akzeptiert.
CHECK_INTERVAL=60
# true = einmal prüfen und beenden; false = Endlosschleife
RUN_ONCE=false

# ===== Optional: E-Mail-Benachrichtigung =====
# NOTIFY_EMAIL=deine@email.de
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=deine@email.de
# SMTP_PASS=dein-smtp-passwort
# SMTP_FROM=deine@email.de